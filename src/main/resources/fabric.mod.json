{
  "schemaVersion": 1,
  "id": "songplayer",
  "version": "${version}",
  "name": "Song Player",
  "description": "A mod for building and playing noteblock songs in Minecraft",
  "authors": [
    "hhhzzzsss"
  ],
  "contact": {
    "sources": "https://github.com/hhhzzzsss/SongPlayer"
  },
  "license": "MIT",
  "icon": "assets/songplayer/icon.png",
